{
 servers {
  max_header_size 16KB
  timeouts {
   read_header 5s
   read_body 15s
   idle 60s
  }
 }
}
{$APP_DOMAIN} {
 encode gzip
 header X-Content-Type-Options nosniff
 header Strict-Transport-Security "max-age=31536000"
 @private path /sentinel/metrics /metrics /sentinel/auth/*
 handle @private {
  respond "Not found" 404
 }
 @gateway path /v1/* /healthz /readyz
 handle @gateway {
  reverse_proxy gateway:18080 {
   flush_interval -1
  }
 }
 handle_path /sentinel/* {
  reverse_proxy sentinel-api:8080
 }
 # Management requires an SSH tunnel to the internal gateway. It is not
 # published through this Internet listener.
 handle {
  respond "Not found" 404
 }
}
